<IfModule mod_rewrite.c>
    Options -Indexes
    RewriteEngine On
    
    # Kalo file atau folder beneran ada, biarkan diakses
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    
    # Kalo ngga ada, arahkan semua request ke index.php
    RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
</IfModule>
